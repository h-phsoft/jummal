# =====================================================
# دراسات عددية في القرآن الكريم: إعدادات الاستضافة (Apache / cPanel)
# يُنسخ مع الموقع تلقائياً عند البناء
# =====================================================

# منع عرض محتويات المجلدات
Options -Indexes

# أنواع الملفات
AddType application/manifest+json .webmanifest
AddType application/json .json
AddType font/woff2 .woff2
AddType font/woff .woff

# ضغط الملفات النصية (البيانات نحو 9 ميغابايت تنضغط كثيراً)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # الصفحة وملفات العمل دون إنترنت تُفحص دائماً لتصل التحديثات فوراً
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # ملفات assets تحمل بصمة في اسمها، فتُحفظ طويلاً
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
